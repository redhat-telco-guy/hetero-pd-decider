# Settings for the NVIDIA mixed-generation lab on OpenShift on AWS (T4 + A10G + L4).
# Used by lab/aws-nvidia/install-all.sh, which reuses the lab/a30-only steps with this file.
NS=hetero-pd-aws                       # separate namespace, so nothing collides with Dual-Key
MODEL=Qwen/Qwen2.5-1.5B-Instruct       # small enough for a 16 GB T4 with room for KV
T4_PRODUCT=Tesla-T4                    # node label nvidia.com/gpu.product (check: oc get nodes -L nvidia.com/gpu.product)
A10G_PRODUCT=NVIDIA-A10G
L4_PRODUCT=NVIDIA-L4
A30_PRODUCT=$L4_PRODUCT                # the shared steps pin the router to this GPU type
GPUS_NEEDED=1
RELEASE=hetero-pd
# Attention backend for all three servers. Empty = vLLM's default per card: FlashAttention on
# A10G and L4, a different backend on the T4 (FlashAttention needs compute capability 8.0+),
# so the T4 gets a different compatibility key. Set e.g. TRITON_ATTN to run all three on one
# backend, which should make their keys match (the B300 + GH200 case from the llm-d thread).
#BACKEND=TRITON_ATTN
BACKEND=
# Router build size: AWS GPU nodes of the xlarge size have 4 vCPU and 16 GiB.
BUILD_CPU=3
BUILD_MEM=12Gi
