# Settings for the A30-only lab. Edit before running install-all.sh.
NS=hetero-pd-lab                       # namespace for model servers, router and dashboard
MODEL=Qwen/Qwen2.5-7B-Instruct         # served model (ungated; needs a Hugging Face token anyway for rate limits)
A30_PRODUCT=NVIDIA-A30                 # value of the node label nvidia.com/gpu.product on the A30 nodes
GPUS_NEEDED=2                          # one A30 reads prompts (prefill), one answers (decode)
RELEASE=hetero-pd                      # Helm release name for the router
