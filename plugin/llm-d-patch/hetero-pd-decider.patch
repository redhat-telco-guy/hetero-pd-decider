+func TestDecideDefaultsKeepPreviousBehaviour(t *testing.T) {
+	c := DefaultConfig()
+	if c.HandoffOverheadMs != 0 || c.StallFraction != 1 {
+		t.Fatalf("defaults changed: handoff %v, stallFraction %v", c.HandoffOverheadMs, c.StallFraction)
+	}
