+# Sample EPP configuration for P/D with prefill and decode pools of different
+# accelerator classes. Pods carry llm-d.ai/role and llm-d.ai/accelerator-class.
+# Profile throughputs are placeholders: measure them for your model and hardware.
+apiVersion: llm-d.ai/v1
+kind: EndpointPickerConfig
+plugins:
+- type: approx-prefix-cache-producer
+  parameters:
+    maxPrefixTokensToMatch: 16384
+    lruCapacityPerServer: 31250
+- type: prefix-cache-scorer
+- type: queue-scorer
+- type: prefill-filter
+- type: decode-filter
+- type: max-score-picker
+- type: disagg-profile-handler
+  parameters:
+    deciders:
+      prefill: hetero-pd-decider
+- type: hetero-pd-decider
+  parameters:
+    kvBytesPerToken: 131072
+    ttftSLOMs: 1000
+    stallWeight: 0.25
+    safetyMargin: 0.1
+    maxDecodeKVUsage: 0.9
+    minUncachedTokens: 256
+    bandwidthGbps: 25
+    avgQueuedPromptTokens: 1024
+    handoffOverheadMs: 300         # measure: remote-path TTFT minus local TTFT, short prompts
+    stallFraction: 0.1             # chunked prefill: running streams lose ~10% of a local prefill
+    fallbackNonCachedTokens: 1024
+    strategy: auto                 # auto | model | guarded-stock
+    overrideMargin: 0.25           # auto overrules stock only when the other path is 25% cheaper
+    stockNonCachedTokens: 1024
+    idleRunningRequests: 2
+    profiles:
+      nvidia-a30:
+        prefillTokensPerSec: 5000
+      intel-gaudi3:
+        prefillTokensPerSec: 20000
+schedulingProfiles:
+- name: prefill
+  plugins:
+  - pluginRef: prefill-filter
+  - pluginRef: max-score-picker
+  - pluginRef: prefix-cache-scorer
+    weight: 2
+  - pluginRef: queue-scorer
+    weight: 1
+- name: decode
+  plugins:
+  - pluginRef: decode-filter
+  - pluginRef: max-score-picker
+  - pluginRef: prefix-cache-scorer
+    weight: 2
+  - pluginRef: queue-scorer
+    weight: 1
