+		`{"bandwidthGbps": 0}`,
+		`{"safetyMargin": 1}`,
+		`{"fallbackNonCachedTokens": -1}`,
+		`{"profiles": {"x": {"prefillTokensPerSec": 0}}}`,
+		`{"bandwidthGbps": "fast"}`,
+	} {
+		_, err := HeteroPDDeciderPluginFactory("h", json.NewDecoder(strings.NewReader(bad)), nil)
