+	c.BandwidthGbps, c.HandoffOverheadMs, c.StallFraction = 10, 82, 0.1
+	if d := Decide(c, 700, busy, []Pod{gaudiPrefill}); !d.Remote || d.Reason != ReasonOverrideMove {
+		t.Errorf("margin 0: got %+v", d)
+	}
