+func TestDecideMissingProfileFallsBack(t *testing.T) {
+	d := Decide(labConfig(), promptLong, Pod{Name: "x", Class: "unknown"}, []Pod{a30(0)})
+	if !d.Fallback {
+		t.Fatalf("want fallback, got %+v", d)
+	}
+}
