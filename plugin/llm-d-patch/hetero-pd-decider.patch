+			name:    "busy decode pod offloads a long prompt",
+			tokens:  heteroPrompt,
+			decode:  heteroEndpoint("gaudi-0", bylabel.RoleDecode, heteroClassGaudi, 40, 0, 0.3, nil),
+			pool:    []scheduling.Endpoint{a30Idle},
+			produce: true,
+			want:    true,
